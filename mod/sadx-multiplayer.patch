 FastFunctionHookPtr<TaskFuncPtr> SonicTheHedgehog_h(0x49A9B0);
+FastFunctionHookPtr<TaskFuncPtr> SonicDisplay_h(0x4948C0);
+FastFunctionHookPtr<TaskFuncPtr> SonicDestruct_h(0x494860);
+FastFunctionHookPtr<TaskFuncPtr> MetalSonicAfterImage_h(0x4959A0);
+FastFunctionHookPtr<TaskFuncPtr> MetalSonicAfterImageDisplay_h(0x4946E0);
+
+// Metal Sonic: MetalSonicFlag is on while that player's Sonic runs (its init loads his textures), draws and is
+// destroyed (which frees them); other players' Sonics see the flag as the game left it.
+static char MetalSonicFlagFor(task* tp)
+{
+	const char flag = MetalSonicFlag;
+	if (multiplayer::IsActive() && multiplayer::IsMetalSonic(TASKWK_PLAYERID(tp->twp)))
+	{
+		MetalSonicFlag = 1;
+	}
+	return flag;
+}
 
 static void SonicHomingOnRings_m(taskwk* twp, motionwk2* mwp, playerwk* pwp)
 {
@@ -227,11 +244,15 @@ static void __cdecl SonicTheHedgehog_r(task* tp)
 	{
 		auto pnum = TASKWK_PLAYERID(tp->twp);
 		auto twp = tp->twp;
+		const char flag = MetalSonicFlagFor(tp);
 
 		gravity::SaveGlobalGravity();
 		gravity::SwapGlobalToUserGravity(pnum);
+		cs::BeforeSonic(tp);
 		SonicTheHedgehog_h.Original(tp);
+		cs::AfterSonic(tp);
 		gravity::RestoreGlobalGravity();
+		MetalSonicFlag = flag;
 	}
 	else
 	{
@@ -239,6 +260,43 @@ static void __cdecl SonicTheHedgehog_r(task* tp)
 	}
 }
 
+static void __cdecl SonicDisplay_r(task* tp)
+{
+	if (multiplayer::IsActive() && cs::Display(tp))
+	{
+		return;
+	}
+	const char flag = MetalSonicFlagFor(tp);
+	SonicDisplay_h.Original(tp);
+	MetalSonicFlag = flag;
+}
+
+static void __cdecl SonicDestruct_r(task* tp)
+{
+	const char flag = MetalSonicFlagFor(tp);
+	SonicDestruct_h.Original(tp);
+	MetalSonicFlag = flag;
+}
+
+// Metal Sonic's after-images are tasks of their own, run and drawn outside his: they only exist for him, so the
+// flag is on while they run. With it off they drew Sonic's model with Metal's textures (crash setting a texture,
+// sonic.exe+0x78CDC9, once he ran fast enough to leave them).
+static void __cdecl MetalSonicAfterImage_r(task* tp)
+{
+	const char flag = MetalSonicFlag;
+	MetalSonicFlag = 1;
+	MetalSonicAfterImage_h.Original(tp);
+	MetalSonicFlag = flag;
+}
+
+static void __cdecl MetalSonicAfterImageDisplay_r(task* tp)
+{
+	const char flag = MetalSonicFlag;
+	MetalSonicFlag = 1;
+	MetalSonicAfterImageDisplay_h.Original(tp);
+	MetalSonicFlag = flag;
+}
+
 void patch_sonic_init()
 {
 	SonicHomingOnRings_h.Hook(SonicHomingOnRings_r);
@@ -247,6 +305,10 @@ void patch_sonic_init()
 	SonicJiggle_h.Hook(SonicJiggle_r);
 	Sonic_CheckInput_hook.Hook(Sonic_CheckInput_r);
 	SonicTheHedgehog_h.Hook(SonicTheHedgehog_r);
+	SonicDisplay_h.Hook(SonicDisplay_r);
+	SonicDestruct_h.Hook(SonicDestruct_r);
+	MetalSonicAfterImage_h.Hook(MetalSonicAfterImage_r);
+	MetalSonicAfterImageDisplay_h.Hook(MetalSonicAfterImageDisplay_r);
 }
 
 RegisterPatch patch_sonic(patch_sonic_init);
